[Unit]
Description=HerePilot-AI: load the HERE server key from SSM Parameter Store into tmpfs
After=network-online.target
Wants=network-online.target
Before=herepilot-backend.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/herepilot-sync-secrets
# SSM or the network can be slow for a moment right after boot; try again before giving up.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
