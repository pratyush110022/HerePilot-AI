# --- HERE (maps, geocoding, places, routing) ---
HERE_API_KEY=
HERE_ROUTING_URL=https://router.hereapi.com/v8/routes
HERE_GEOCODE_URL=https://geocode.search.hereapi.com/v1/geocode
HERE_DISCOVER_URL=https://discover.search.hereapi.com/v1/discover
# Native HERE EV routing needs a vehicle consumption model this app does not have. Leave false:
# EV results come from the built-in planner and the bundled charging dataset.
HERE_EV_ENABLED=false

# --- Optional live OpenStreetMap fallback for place search ---
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- AI: AWS Bedrock (optional; without it the assistant uses rule-based understanding) ---
# bedrock | none
LLM_PROVIDER=bedrock
# A model ID or inference-profile ID your AWS account has been granted access to. There is no default.
BEDROCK_MODEL_ID=
# Optional: defaults to AWS_REGION / AWS_DEFAULT_REGION / your AWS profile's region.
BEDROCK_REGION=
# Credentials come from the standard AWS chain (IAM role, SSO/login session, shared profile).
# Select a profile explicitly; the app never picks one for you. Never put AWS keys in this file.
# AWS_PROFILE=your-profile-name
BEDROCK_TIMEOUT_SECONDS=30
# Spend guard: the most model calls this process will make. At a limit the assistant answers from its built-in
# rules until the window lifts (hourly = rolling 60 minutes, daily = UTC day). 0 switches a limit off.
# One chat message uses 1 to 3 calls.
BEDROCK_HOURLY_CALL_LIMIT=100
BEDROCK_DAILY_CALL_LIMIT=600
# Optional: keep the daily count across restarts.
# BEDROCK_USAGE_STATE_FILE=/var/lib/herepilot/bedrock-usage.json

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- HTTP / TLS ---
# TLS certificate verification is always on. Behind a TLS-inspecting corporate proxy, add its root CA
# (PEM file) here; it is added to the default trust store, not used instead of it.
# GEO_HTTP_CA_BUNDLE=/path/to/corporate-root-ca.pem

# --- CORS (comma-separated origins; defaults to the local Vite dev/preview ports) ---
# CORS_ALLOW_ORIGINS=http://localhost:5173
